# Normalize line endings (project was developed on Windows)
* text=auto eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf
*.cmd  text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.doc  binary
*.pdf  binary

# Don't count generated/lock files in language stats
pubspec.lock     linguist-generated
package-lock.json linguist-generated
web_coordinator/src/components/ui/* linguist-vendored
